# Application
APP_NAME="Student Insurance Tracking System"
APP_URL=http://localhost/InsuranceTrackingSystem
# Production (Netlify): https://your-site.netlify.app
# Used for email confirmation links — must match Supabase → Auth → URL Configuration
APP_ENV=local
APP_DEBUG=true

# Session (15 minutes inactivity)
SESSION_TIMEOUT=900
SESSION_NAME=SITS_SESSION

# Login lockout (5 attempts in 15 minutes)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Email (SMTP for notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=markpiamonte128@gmail.com
MAIL_PASSWORD=ortsbvbqyplaoqui
MAIL_FROM_ADDRESS=noreply@university.edu
MAIL_FROM_NAME="Insurance Tracking System"
MAIL_TIMEOUT=20

# Password reset (6-digit code via email)
PASSWORD_RESET_CODE_EXPIRY_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
PASSWORD_RESET_MAX_ATTEMPTS=5

# Google sign-in (recommended: direct OAuth — no Supabase Google provider required)
# 1. Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web)
# 2. Authorized redirect URI: {APP_URL}/auth/google-callback.php
#    e.g. http://localhost/InsuranceTrackingSystem/auth/google-callback.php
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: if GOOGLE_CLIENT_ID is empty, falls back to Supabase /auth/v1/authorize (requires
# Google enabled under Supabase Dashboard → Authentication → Providers → Google)
GOOGLE_OAUTH_ENABLED=true

# Security
CSRF_TOKEN_NAME=csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
